# Terraform working directory and downloaded providers
.terraform/

# Terraform state (may contain sensitive values)
*.tfstate
*.tfstate.*

# Local variable values and plan files
terraform.tfvars
*.tfvars
!terraform.tfvars.example
*.tfplan

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local Terraform CLI configuration
.terraformrc
terraform.rc
